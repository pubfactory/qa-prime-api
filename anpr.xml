<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MERIDIAN" verbose="5"
	parallel="tests" thread-count="3" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>

	<test name="PDF_WORK" preserve-order="true">
		<parameter name="application" value="anesthesiaprogress" />
		<groups>
			<run>
				<include name="anesthesiaprogress" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.PDFFunctionalityTest">
				<methods>
					<include name="verifyPDFButonAvailableAndDownloadPDF">
						<parameter name="testcaseid" value="1722758" />
					</include>
					<include
						name="VerifyPDFFeaturesInRestrictedAccessContentPage">
						<parameter name="testcaseid" value="1722759" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
</suite>
