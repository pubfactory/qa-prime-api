<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PROTOTYPE_PROXY" verbose="5" parallel="tests"
	thread-count="3" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>
	<test name="OPENURLROUTE" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.OpenURLTest">
				<methods>
					<include name="VerifyThatOpenURLRouteFunctionality">
						<parameter name="testcaseid" value="1736541" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
</suite>
