<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PROTOTYPE_PROXY" verbose="5" parallel="tests"
	thread-count="3" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>

	<test name="ADVANCE_SEARCH" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class
				name="com.prime.tests.E2E.AdvancedSearchToRefineTermsAndDate">
				<methods>
					<include
						name="VerifyAdvancedFilterInRefineTermsDateInTheSearchResultsPage">
						<parameter name="testcaseid" value="1730099" />
					</include>
					<include
						name="verifyThatAdvancedRefineByDateFilterFunctionality">
						<parameter name="testcaseid" value="1730100" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
	<test name="COPYPREVIEWCITATION" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.CopyPreviewCitationTest">
				<methods>
					<include
						name="VerifyThatUserAbleToPerformCopyPreviewCitationOperation">
						<parameter name="testcaseid" value="1729633" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
	<test name="HITHIGHLIGHTING" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.HitHighlightingTest">
				<methods>
					<include name="VerifyThattheHitHighlightingFuctionality">
						<parameter name="testcaseid" value="1729632" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
	<test name="AUTOCOMPLETE" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.AutoCompleteTypeAhead">
				<methods>
					<include
						name="verifythatTheAutoCompleteTypeAheadFunctionality">
						<parameter name="testcaseid" value="1729939" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
	<test name="OPENURLROUTE" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.OpenURLTest">
				<methods>
					<include
						name="VerifyThatOpenURLRouteFunctionality">
						<parameter name="testcaseid" value="1736541" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
</suite>
