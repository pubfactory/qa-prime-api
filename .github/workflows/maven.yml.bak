# This workflow will build a Java project with Maven, and cache/restore any dependencies to improve the workflow execution time
# For more information see: https://docs.github.com/en/actions/automating-builds-and-tests/building-and-testing-java-with-maven

# This workflow uses actions that are not certified by GitHub.
# They are provided by a third-party and are governed by
# separate terms of service, privacy policy, and support
# documentation.

name: Java CI with Maven

on:
  workflow_dispatch:
    inputs:
      gitcommitId:
        required: true
        description: "get git commit Id from prime-frontend"
        type: string
        default: ''
      jobId:
        required: true
        description: "get job Id from prime-frontend"
        type: string
        default: ''
jobs:
  build:

    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3
    - name: Set up JDK 8
      uses: actions/setup-java@v3
      with:
        java-version: '8'
        distribution: 'temurin'
        cache: maven
    - name: Install Google Chrome
      uses: browser-actions/setup-chrome@latest
    - name: Navigating to chromedriver and making it executable
      run: |
          cd /home/runner/work/qa-prime-e2e/qa-prime-e2e/src/test/resources
          chmod +x chromedriver
    - name: Build with Maven
      run: mvn test -DsuiteXmlFile=PrimeConfig.xml  -DEnvironment=dev -Dapplication=anesthesiaprogress -Dbrowser=chrome

    - name: Get Allure history
      uses: actions/checkout@v2
      if: always()
      continue-on-error: true
      with:
        ref: gh-pages
        path: gh-pages

    - name: Allure Report action from marketplace
      uses: simple-elf/allure-report-action@master
      if: always()
      id: allure-report
      with:
          allure_results: target/allure-results
          gh_pages: gh-pages
          allure_report: allure-report
          allure_history: allure-history
          
    - name: Deploy report to Github Pages
      if: always()
      uses: peaceiris/actions-gh-pages@v2
      env:
        PERSONAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        PUBLISH_BRANCH: gh-pages
        PUBLISH_DIR: allure-history
        keep_files: true

    - name: Send ${{ job.status }} message to #qa-prime-integration room
      uses: act10ns/slack@v2.0.0
      with:
          webhook-url: ${{ secrets.SLACK_WEBHOOK_URL }}
          status: ${{ job.status }}
          steps: ${{ toJson(steps) }}
          channel: '#qa-prime-integration'
          message: Build Status :${{ job.status }}.
                  Allure report url is :https://pubfactory.github.io/qa-prime-e2e/${{ github.run_number }}
                  Git commitId is ${{inputs.gitcommitId}} .
                  Prime-frontend job is :https://github.com/pubfactory/prime-frontend/actions/runs/${{inputs.jobId}}
                  
      env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}

