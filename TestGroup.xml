<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MultiApplicationSuite">

	<test name="CITATION_E2E" preserve-order="true">
	<groups>
			<run>
				<include name="anesthesiaprogress" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.CitationTest">
				<methods>
					<include
						name="verifyCitationButonAvailableAndPreviewExportCitationPopUpWillBeDisplayedWhenClickedOnIt">
						<parameter name="testcaseid" value="1721296" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
	<test name="SEARCH_E2E_FULL" preserve-order="true">
	<groups>
			<run>
				<include name="anesthesiaprogress" />
			</run>
		</groups>
		<classes>
			<class name="com.prime.tests.E2E.SearchFunctionalityTest">
				<methods>
					<include name="VerifySearchPageTopPanel">
						<parameter name="testcaseid" value="1722541" />
					</include>
					<include
						name="VerifyPpaginationAndSortingOptionsIntheSearchResultsPage">
						<parameter name="testcaseid" value="1722542" />
					</include>
					<include
						name="VerifyThatSsearchResultsDetailsToolbarOptionsSaveOptionsAreAsExpected">
						<parameter name="testcaseid" value="1722543" />
					</include>
					<include
						name="VerifyVariousRefineTermsInTheSearchResultsPage">
						<parameter name="testcaseid" value="1722544" />
					</include>
					<include
						name="VerifyUserIsAbleToPerformSearchWithTheCombinationOfRefineTermsByAddingClearingRemovingMoreThanOneRows">
						<parameter name="testcaseid" value="1722545" />
					</include>
					<include
						name="VerifyThatTheAppropriateResultIsDisplayedWhenUserSelectTheArticleTypeFilterAndAccessTypeFilterFromIndexCard">
						<parameter name="testcaseid" value="1722546" />
					</include>
					<include name="VerifyThatTheVariousShareButtonFeatures">
						<parameter name="testcaseid" value="1722547" />
					</include>
					<include
						name="VerifyRefineByDateSectionAndThatSearchBoxIsAccessibleInAllPages">
						<parameter name="testcaseid" value="1722548" />
