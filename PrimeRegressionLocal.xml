<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Prime Automation E2E Suite" verbose="5" parallel="tests"
	thread-count="17" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>

  	<test name="SEARCH_E2E" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.IntegrationE2EFlow">
			</class>
		</classes>
	</test>
	<test name="JOURNAL_HOME_E2E" preserve-order="true">
		<classes>
			<class
				name="com.prime.tests.E2E.UnAuthenticatedViewCheckPagesFlow">
			</class>
		</classes>
	</test>
	<test name="CITATION_E2E" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.CitationTest">
			</class>
		</classes>
	</test> 
	 
		<test name="SEARCH_E2E_FULL" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.SearchFunctionalityTest">
			</class>
		</classes>
	</test>
	
		<test name="JOURNAL_TOC" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.ToCFunctionalityTest">
			</class>
		</classes>
	</test>
	
	<test name="DISCOVERY_WIDGET" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.DiscoveryWidgetTest">
			</class>
		</classes>
	</test>
	
		<test name="PDF_WORK" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.PDFFunctionalityTest">
			</class>
		</classes>
	</test>

</suite>

