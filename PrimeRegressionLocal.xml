<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Prime Automation E2E Suite" verbose="5" parallel="tests"
	thread-count="17" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>

  	<test name="SEARCH_E2E" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.IntegrationE2EFlow">
			<methods>
			<include 
			name="verifyThatUserAbleToLaunchApplication">
			</include>
			</methods>
			</class>
		</classes>
	</test>
	<test name="JOURNAL_HOME_E2E" preserve-order="true">
		<classes>
			<class
				name="com.prime.tests.E2E.UnAuthenticatedViewCheckPagesFlow">
				<methods>
			<include 
			name="verifyThatViewPagesDisplayed">
			</include>
			</methods>
			</class>
		</classes>
	</test>
	<test name="CITATION_E2E" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.CitationTest">
			<methods>
			<include 
			name="verifyCitationButonAvailableAndPreviewExportCitationPopUpWillBeDisplayedWhenClickedOnIt">
			</include>
			</methods>
			</class>
		</classes>
	</test> 
	 
		<test name="SEARCH_E2E_FULL" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.SearchFunctionalityTest">
			<methods>
			<include 
			name="VerifySearchPageTopPanel">
			</include>
			<include 
			name="VerifyPpaginationAndSortingOptionsIntheSearchResultsPage">
			</include>
			<include 
			name="VerifyThatSsearchResultsDetailsToolbarOptionsSaveOptionsAreAsExpected">
			</include>
			<include 
			name="VerifyVariousRefineTermsInTheSearchResultsPage">
			</include>
			<include 
			name="VerifyUserIsAbleToPerformSearchWithTheCombinationOfRefineTermsByAddingClearingRemovingMoreThanOneRows">
			</include>
			<include 
			name="VerifyThatTheAppropriateResultIsDisplayedWhenUserSelectTheArticleTypeFilterAndAccessTypeFilterFromIndexCard">
			</include>
			<include 
			name="VerifyThatTheVariousShareButtonFeatures">
			</include>
			<include 
			name="VerifyRefineByDateSectionAndThatSearchBoxIsAccessibleInAllPages">
			</include>
			</methods>
			</class>
		</classes>
	</test>
	
		<test name="JOURNAL_TOC" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.ToCFunctionalityTest">
			<methods>
			<include 
			name="VerifyJournalToCFeatures">
			</include>
			</methods>
			</class>
		</classes>
	</test>
	
	<test name="DISCOVERY_WIDGET" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.DiscoveryWidgetTest">
			<methods>
			<include 
			name="VerifyVariousEmailButtonFeatures">
			</include>
			<include 
			name="VerifyGoogleScholarButtonFeatures">
			</include>
			<include 
			name="VerifyPubMedButtonFeaturesAndAlmetricPageFeatures">
			</include>
			</methods>
			</class>
		</classes>
	</test>
	
		<test name="PDF_WORK" preserve-order="true">
		<classes>
			<class name="com.prime.tests.E2E.PDFFunctionalityTest">
			<methods>
			<include 
			name="verifyPDFButonAvailableAndDownloadPDF">
			</include>
			<include 
			name="VerifyPDFFeaturesInRestrictedAccessContentPage">
			</include>
			</methods>
			</class>
		</classes>
	</test>

</suite>
