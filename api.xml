<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PRIME_API" verbose="5" parallel="tests"
	thread-count="3" preserve-order="true">
	<listeners>
		<listener class-name="com.prime.retryAnalyzers.RetryListener" />
	</listeners>

	<test name="API_Test" preserve-order="true">
		<parameter name="application" value="proxy" />
		<groups>
			<run>
				<include name="proxy" />
			</run>
		</groups>
		<classes>
			<class
				name="com.prime.tests.api.RestAssuredAPITest2">
				<methods>
					<include
						name="VerifyAPITests">
						<parameter name="testcaseid" value="1737005" />
					</include>
				</methods>
			</class>
		</classes>
	</test>
</suite>
